# =============================================================================
# HarvestIQ Backend Environment Configuration Template
# =============================================================================
# Copy this file to .env for local overrides.
# Render automatically injects PORT and allows setting environment variables
# in the Render Dashboard under "Environment".

# Dynamic server port (Render assigns $PORT dynamically)
PORT=8000

# Network host binding (0.0.0.0 binds to all network interfaces)
HOST=0.0.0.0

# Allowed CORS Origins (comma-separated)
# In production, restrict to your deployed frontend domain:
# CORS_ORIGINS=https://harvestiq-web.onrender.com,http://localhost:3000
# Leave as * or unset for local development
CORS_ORIGINS=*

# Application Environment (development, testing, production)
ENVIRONMENT=production
