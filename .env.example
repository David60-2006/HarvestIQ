# =============================================================================
# HarvestIQ – Root Environment Configuration Template
# =============================================================================
# For backend configuration, see backend/.env.example
# Render automatically injects $PORT and hosts environment variables.

# FastAPI Backend Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*
ENVIRONMENT=production

# Frontend Static Configuration
# In production, set to your deployed Render Web Service URL (e.g., https://harvestiq-api.onrender.com)
HARVESTIQ_API_URL=http://127.0.0.1:8000
